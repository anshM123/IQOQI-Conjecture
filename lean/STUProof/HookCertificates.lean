import STUProof.KirwanFreeHook

/-!
# Hook decompositions of the `n`-box for `n ≤ 20` (exact certificates)

The data are the exact rational hook decompositions of P-STU3 (`stu3/hookdec_n{n}.txt`,
computed with an LP solver and then solved exactly over `ℚ`), scaled by a common denominator
`D` to natural numbers. Every constraint of `IsHookDecomposition` is checked by the Lean kernel
(`decide +kernel`, integer arithmetic only), and `hookDecomposition_of_nat` turns the checked
integer data into a real hook decomposition.
-/

open Finset

namespace STUProof

/-- Integer-scaled hook decomposition: `y a s i = D · x a s i` for a hook decomposition `x`
(the nonnegativity is automatic in `ℕ`). -/
def IsHookDecompositionNat (n D : ℕ) (y : ℕ → ℕ → ℕ → ℕ) : Prop :=
  (∀ a < n, ∀ s ≤ a, ∑ i ∈ range (n - s), y a s i = D) ∧
  (∀ a < n, ∀ r < n, n * (y a 0 r + ∑ s ∈ Icc 1 a,
    ((if r + s ≤ n - 1 then y a s r else 0) + (if s ≤ r then y a s (r - s) else 0))) =
      (2 * a + 1) * D) ∧
  (∀ s < n, ∀ i < n - s, ∑ a ∈ Ico s n, y a s i = D)

/-- Table lookup: `tbl[a][s][i]`, zero outside the table. -/
def hookNatX (tbl : List (List (List ℕ))) (a s i : ℕ) : ℕ :=
  ((tbl.getD a []).getD s []).getD i 0

/-- An integer-scaled hook decomposition gives a (real) hook decomposition. -/
theorem hookDecomposition_of_nat {n D : ℕ} (hD : 0 < D) {y : ℕ → ℕ → ℕ → ℕ}
    (h : IsHookDecompositionNat n D y) : HookDecomposition n := by
  obtain ⟨h1, h2, h3⟩ := h
  have hD' : (0 : ℝ) < D := by exact_mod_cast hD
  refine ⟨fun a s i => (y a s i : ℝ) / D, fun a _ s _ i _ => by positivity, ?_, ?_, ?_⟩
  · intro a ha s hs
    show ∑ i ∈ range (n - s), (y a s i : ℝ) / D = 1
    rw [← Finset.sum_div, div_eq_one_iff_eq hD'.ne']
    exact_mod_cast h1 a ha s hs
  · intro a ha r hr
    show (y a 0 r : ℝ) / D + ∑ s ∈ Icc 1 a,
      ((if r + s ≤ n - 1 then (y a s r : ℝ) / D else 0) +
        (if s ≤ r then (y a s (r - s) : ℝ) / D else 0)) = (2 * (a : ℝ) + 1) / n
    have hn : (0 : ℝ) < n := by exact_mod_cast (show 0 < n by omega)
    have key : (n : ℝ) * ((y a 0 r : ℝ) + ∑ s ∈ Icc 1 a,
        ((if r + s ≤ n - 1 then (y a s r : ℝ) else 0) +
          (if s ≤ r then (y a s (r - s) : ℝ) else 0))) = (2 * (a : ℝ) + 1) * D := by
      exact_mod_cast h2 a ha r hr
    have e : (y a 0 r : ℝ) / D + ∑ s ∈ Icc 1 a,
        ((if r + s ≤ n - 1 then (y a s r : ℝ) / D else 0) +
          (if s ≤ r then (y a s (r - s) : ℝ) / D else 0)) =
        ((y a 0 r : ℝ) + ∑ s ∈ Icc 1 a,
          ((if r + s ≤ n - 1 then (y a s r : ℝ) else 0) +
            (if s ≤ r then (y a s (r - s) : ℝ) else 0))) / D := by
      rw [add_div, Finset.sum_div]
      congr 1
      refine Finset.sum_congr rfl (fun s _ => ?_)
      split_ifs <;> ring
    rw [e, div_eq_div_iff hD'.ne' hn.ne']
    linarith
  · intro s hs i hi
    show ∑ a ∈ Ico s n, (y a s i : ℝ) / D = 1
    rw [← Finset.sum_div, div_eq_one_iff_eq hD'.ne']
    exact_mod_cast h3 s hs i hi

/-- Exact hook decomposition of the 1-box, scaled by `1` (data of `stu3/hookdec_n1.txt`). -/
def hookNat1 : List (List (List ℕ)) :=
  [
    [[1]]
  ]

set_option maxRecDepth 1000000 in
theorem hookNat1_valid : IsHookDecompositionNat 1 1 (hookNatX hookNat1) := by
  unfold IsHookDecompositionNat
  decide +kernel

theorem hookDecomposition_1 : HookDecomposition 1 :=
  hookDecomposition_of_nat (by norm_num) hookNat1_valid

